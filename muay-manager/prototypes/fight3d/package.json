{
  "name": "muay-fight3d-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "batch": "node tools/batch.mjs",
    "test": "node tools/determinism.mjs && node tools/match-test.mjs",
    "site": "node build.mjs && npx --yes wrangler@4 pages dev dist/site",
    "deploy": "node tools/deploy-site.mjs",
    "e2e:single": "node tools/e2e/single-fight.mjs",
    "e2e:challenge": "node tools/e2e/challenge-flow.mjs",
    "e2e:live": "node tools/e2e/live-fight.mjs",
    "e2e:update": "node tools/e2e/self-update.mjs",
    "e2e:mon": "node tools/e2e/mon.mjs",
    "serve": "node --disable-warning=ExperimentalWarning server/server.mjs",
    "e2e:full": "node tools/e2e/full-play.mjs",
    "e2e:account": "node tools/e2e/account.mjs",
    "report": "node --disable-warning=ExperimentalWarning tools/tester-report.mjs",
    "e2e:social": "node tools/e2e/social.mjs",
    "e2e:cup": "node tools/e2e/cup.mjs",
    "e2e:nogl": "node tools/e2e/no-webgl.mjs",
    "chat": "node tools/chat-admin.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "three": "^0.160.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
