{
  //Loaded only when ASPNETCORE_ENVIRONMENT=Production, which deploy/systemd/rorebuild.service sets.
  //Behind nginx: nginx owns 80/443 and proxies to this port, and only this machine can reach
  //the port directly. See deploy/nginx/rorebuild.conf and docs/PHASE3-VPS.md.
  "urls": "http://127.0.0.1:5000",
  "WebClientPath": "WebClient",
  "ServerOperationConfig": {
    "LiveServer": true,
    "AdminAccounts": [ "gmrebuild" ],
    "GmSeedFile": "GmAccount.local.json",
    "KeyPersistencePath": "Keys/",
    "AllowAdminifyCommand": false,
    "AdminifyPasscode": "",
    //Five minutes, because a browser is not a game client.
    //
    //The keep-alive goes out from Update(), Unity drives Update() from
    //requestAnimationFrame, and Chrome stops requestAnimationFrame dead for a tab
    //that is not on screen. A player who switches to another window sends nothing at
    //all until they switch back, however healthy the connection is. Twenty seconds
    //meant reading one message got you logged out. Ninety was still short enough that
    //three windows left open while their owner did something else all timed out
    //together, to the millisecond, which is what sent us looking for a server fault
    //that was not there.
    //
    //Nothing is given up for it. ScanAndDisconnect drops a socket that is not Open
    //before it ever consults this timer, so a browser that was closed, a tab that was
    //shut and a connection that genuinely died are all still noticed at once. This
    //number only governs a connection that is open and quiet - which in a browser
    //means minimised, not gone - and the cost of being wrong about one is a player
    //slot held for a few minutes longer.
    "ClientTimeoutSeconds": 300,
    //the first closed test: about twenty people, a few spare accounts, nobody making ten
    "MaxOnlinePlayers": 25,
    "AllowRegistration": true,
    "MaxAccounts": 30,
    "MaxNewAccountsPerAddressPerDay": 3,
    "MaxFailedLoginsPerAddress": 10
  },
  "ServerDataConfig": {
    "DataPath": "./ServerData/",
    "CachePath": "./Cache/",
    "CacheScripts": true,
    "CompileScriptsOutOfProcess": false,
    "WalkPathData": "./walkdata/"
  },
  "ServerDebugConfig": {
    "UseDebugMode": false,
    "EnableWarpCommandForEveryone": false,
    "EnableRandomMoveForEveryone": false,
    "EnableEnterSpecificMap": false,
    "UnlimitedSkillPoints": false,
    "DebugMapOnly": false
  }
}
