{
  //Loaded only when ASPNETCORE_ENVIRONMENT=Production, which deploy/systemd/rorebuild.service sets.
  //Behind nginx: nginx owns 80/443 and proxies to this port, and only this machine can reach
  //the port directly. See deploy/nginx/rorebuild.conf and docs/PHASE3-VPS.md.
  "urls": "http://127.0.0.1:5000",
  "WebClientPath": "WebClient",
  "ServerOperationConfig": {
    "LiveServer": true,
    "AdminAccounts": [ "gmrebuild" ],
    "GmSeedFile": "GmAccount.local.json",
    "KeyPersistencePath": "Keys/",
    "AllowAdminifyCommand": false,
    "AdminifyPasscode": "",
    //Ninety rather than twenty, because a browser is not a game client.
    //
    //The keep-alive is sent from Update(), and Unity drives Update() from
    //requestAnimationFrame, which Chrome stops completely for a tab that is not on
    //screen. So a player who alt-tabs to read a message sends nothing at all, and at
    //twenty seconds the server decides they are gone - while their connection is
    //still perfectly open. They come back to "Lost connection to server".
    //
    //This costs nothing in detecting real disconnections: ScanAndDisconnect drops a
    //socket that is not Open before it ever looks at this timer. The timer only
    //governs a connection that is alive and silent, which in a browser means
    //"minimised", not "dead".
    "ClientTimeoutSeconds": 90,
    //the first closed test: about twenty people, a few spare accounts, nobody making ten
    "MaxOnlinePlayers": 25,
    "AllowRegistration": true,
    "MaxAccounts": 30,
    "MaxNewAccountsPerAddressPerDay": 3,
    "MaxFailedLoginsPerAddress": 10
  },
  "ServerDataConfig": {
    "DataPath": "./ServerData/",
    "CachePath": "./Cache/",
    "CacheScripts": true,
    "CompileScriptsOutOfProcess": false,
    "WalkPathData": "./walkdata/"
  },
  "ServerDebugConfig": {
    "UseDebugMode": false,
    "EnableWarpCommandForEveryone": false,
    "EnableRandomMoveForEveryone": false,
    "EnableEnterSpecificMap": false,
    "UnlimitedSkillPoints": false,
    "DebugMapOnly": false
  }
}
