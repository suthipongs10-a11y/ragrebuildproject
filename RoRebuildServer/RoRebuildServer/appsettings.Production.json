{
  //Loaded only when ASPNETCORE_ENVIRONMENT=Production, which deploy/systemd/rorebuild.service sets.
  //Behind nginx: nginx owns 80/443 and proxies to this port, and only this machine can reach
  //the port directly. See deploy/nginx/rorebuild.conf and docs/PHASE3-VPS.md.
  "urls": "http://127.0.0.1:5000",
  "WebClientPath": "WebClient",
  "ServerOperationConfig": {
    "LiveServer": true,
    "AdminAccounts": [ "gmrebuild" ],
    "GmSeedFile": "GmAccount.local.json",
    "KeyPersistencePath": "Keys/",
    "AllowAdminifyCommand": false,
    "AdminifyPasscode": "",
    "ClientTimeoutSeconds": 20,
    //the first closed test: about twenty people, a few spare accounts, nobody making ten
    "MaxOnlinePlayers": 25,
    "AllowRegistration": true,
    "MaxAccounts": 30,
    "MaxNewAccountsPerAddressPerDay": 3,
    "MaxFailedLoginsPerAddress": 10
  },
  "ServerDataConfig": {
    "DataPath": "./ServerData/",
    "CachePath": "./Cache/",
    "CacheScripts": true,
    "CompileScriptsOutOfProcess": false,
    "WalkPathData": "./walkdata/"
  },
  "ServerDebugConfig": {
    "UseDebugMode": false,
    "EnableWarpCommandForEveryone": false,
    "EnableRandomMoveForEveryone": false,
    "EnableEnterSpecificMap": false,
    "UnlimitedSkillPoints": false,
    "DebugMapOnly": false
  }
}
