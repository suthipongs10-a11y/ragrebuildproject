{
  //0.0.0.0 rather than localhost: localhost accepts connections from this machine only,
  //so a phone on the same wifi is refused before it ever reaches the game. Change it back
  //if you want the server unreachable from the rest of the network.
  "urls": "http://0.0.0.0:5000",
  //where the browser build lives, relative to the server executable. Left alone it is a
  //folder that does not exist until you make a WebGL build, and the server says so and
  //carries on serving the socket.
  "WebClientPath": "WebClient",
  "ServerOperationConfig": {
    //THE SWITCH TO FLIP BEFORE ANYBODY ELSE IS LET IN. Set it to true and the server shuts
    //every cheat setting itself at startup - debug mode, adminify, /warp for everyone - no
    //matter what the rest of this file or appsettings.Development.json says. Leave it false
    //and the server says so in the log on every single boot, listing what is open.
    //With it on, the only GMs are the accounts named in AdminAccounts below.
    "LiveServer": false,
    "AdminAccounts": [], //account names that are GM. e.g. [ "konami" ]. The account in GmSeedFile counts as one without being listed.
    "GmSeedFile": "GmAccount.local.json", //the GM account the server creates for itself on first boot. Kept out of git, see GmAccount.example.json.
    "MaxOnlinePlayers": 0, //0 = no limit. A named GM is let in past the limit.
    "AllowRegistration": true, //false turns the server into a closed test: nobody new can make an account
    "MaxAccounts": 0, //0 = no limit. Registration closes itself once this many accounts exist.
    "MaxNewAccountsPerAddressPerDay": 3, //0 = no limit
    "MaxFailedLoginsPerAddress": 10, //wrong passwords per 10 minutes before an address is turned away. 0 = no limit
    "KeyPersistencePath": "Keys/",
    "UseMultipleThreads": true,
    //Ninety rather than twenty, because a browser is not a game client.
    //
    //The keep-alive is sent from Update(), and Unity drives Update() from
    //requestAnimationFrame, which Chrome stops completely for a tab that is not on
    //screen. So a player who alt-tabs to read a message sends nothing at all, and at
    //twenty seconds the server decides they are gone - while their connection is
    //still perfectly open. They come back to "Lost connection to server".
    //
    //This costs nothing in detecting real disconnections: ScanAndDisconnect drops a
    //socket that is not Open before it ever looks at this timer. The timer only
    //governs a connection that is alive and silent, which in a browser means
    //"minimised", not "dead".
    "ClientTimeoutSeconds": 90,
    "MapChunkSize": 16,
    "UseAccurateSpawnZoneFormula": true, //uses official server formula where each monster has their spawn area randomly offset within the original zone.
    "AllowAdminifyCommand": true, //private test server, /adminify aaaa turns the GM commands on. LiveServer forces this off.
    "RemapDropRates": true, //on: the server's own curve. Script/Config/ItemDropAndValueAdjustments.txt turns a card's 0.01% into 0.25%
    "AdminifyPasscode": "aaaa",
    "EtcItemValueMultiplier": "2",
    "GuaranteeMvpDrops": true, //if an mvp doesn't drop anything, uses a weighted test (sum of all drop chances) to ensure at least one item drops
    "RestrictMonsterSkillsToBosses": true, //episode 4: ordinary monsters swing, only mvps and spawns flagged as bosses keep their skills
    "SpawnGiftMonsters": true, //one Antonio on every map, towns included. Never attacks, drops Gift Box / Red Stocking / Candy and rarely a Water Lily Hat.
    "OfflineVendingHours": 48, //how long a vending shop keeps selling after its owner logs out. 0 turns the feature off.
    "FliersIgnoreTraps": false, //makes flying monsters not trigger traps. You can still hit flying monsters if you manually trigger a trap.
    "EmptyMapTimer": 180, //seconds to wait before a map is considered unoccupied and to stop updating monsters
    "SleepMonsterOnEmptyMap": true, //slept monsters will not enable their AI unless a player comes on screen. Monsters visible on the minimap are excluded.
    "DefaultCastInterruptMode": "InterruptOnSkill", //InterruptOnDamage, InterruptOnSkill, InterruptOnKnockback, or NeverInterrupt
    "ActiveEvents": [ "MilestoneEvent", "AdventureBook", "BossLog" ],
    "FeatureFlags": [] //use "DoddlerCustomMonsters" to enable the custom monsters
  },
  "ServerDataConfig": {
    "DataPath": "../GameConfig/ServerData/",
    "CachePath": "./Cache/",
    "CacheScripts": true,
    "CompileScriptsOutOfProcess": false,
    "WalkPathData": "..\\..\\RebuildClient\\Assets\\Maps\\exportdata"
  },
  "ServerCharacterEntry": {
    "Map": "prt_fild08",
    "X": 166,
    "Y": 360,
    "Area": 5
  },
  "ServerDebugConfig": {
    //every setting in this section is forced off when LiveServer is true
    "EnableWarpCommandForEveryone": true, //any player can /warp anywhere. Testing only.
    "EnableRandomMoveForEveryone": false,
    "MaxSpawnTime": 360000, //max spawn time for monsters in ms. 0 disables override.
    "MinSpawnTime": 2000 //force map monsters to wait this long (in ms) before respawning.
  },
  "ConnectionStrings": {
    "DefaultConnection": "Filename=./RoCharacterDatabase.db"
  }
}
