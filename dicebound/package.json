{
  "name": "dicebound",
  "version": "0.0.0",
  "private": true,
  "description": "DICEBOUND — dice-board roguelike auto-battler",
  "author": "DICEBOUND",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json && node tools/write-electron-pkg.mjs",
    "build:win": "npm run check && npm run build && npm run build:electron && electron-builder --win --x64",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate:data": "tsx tools/validate-data.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate:data",
    "assets": "echo \"asset pipeline lands in M1\" && exit 1",
    "balance": "echo \"balance bots land in M5\" && exit 1"
  },
  "build": {
    "appId": "com.dicebound.game",
    "productName": "DICEBOUND",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pixi/sound": "^6.0.3",
    "@types/node": "^22.20.7",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.16.0",
    "globals": "^17.14.0",
    "pixi.js": "^8.23.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wait-on": "^9.5.1",
    "zod": "^4.6.7"
  }
}
